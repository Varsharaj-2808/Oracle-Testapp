# ---------------------------------------------------------------------------
# Copy this file to `.env` in the project root and fill in your real values:
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env
#
# `.env` is gitignored and must never be committed.
# Every value below is intentionally EMPTY. No real credentials belong here.
# ---------------------------------------------------------------------------


# --- Server -----------------------------------------------------------------

# Port the Express API listens on.
PORT=4000

# development | production
NODE_ENV=development

# Frontend origin allowed by CORS. Multiple origins can be comma-separated.
CORS_ORIGIN=http://localhost:5173


# --- Supabase ---------------------------------------------------------------
# Supabase Dashboard > Project Settings > API

# Project URL, e.g. https://<project-ref>.supabase.co   (leave empty here)
SUPABASE_URL=

# SECRET. Server-side only. Grants full database access and bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Public anon key. Safe to expose to a browser, kept server-side in this sample.
SUPABASE_ANON_KEY=


# --- Brevo ------------------------------------------------------------------
# Brevo Dashboard > SMTP & API > API Keys

# SECRET. Your Brevo API key (starts with "xkeysib-"). Server-side only.
BREVO_API_KEY=

# A verified sender address in your Brevo account.
BREVO_SENDER_EMAIL=

# Display name shown as the sender.
BREVO_SENDER_NAME=
